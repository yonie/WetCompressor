<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
	<fonts>
		<font name="TinyFont" font-name="Arial" size="0"/>
	</fonts>

	<colors>
		<color name="Transparent" rgba="#00000000"/>
	</colors>

	<control-tags>
		<control-tag name="kInputParam" tag="0"/>
		<control-tag name="kOutputParam" tag="1"/>
		<control-tag name="kModeParam" tag="2"/>
		<control-tag name="kInputMeterL" tag="3"/>
		<control-tag name="kInputMeterR" tag="4"/>
		<control-tag name="kGRMeter" tag="5"/>
		<control-tag name="kOutputMeterL" tag="6"/>
		<control-tag name="kOutputMeterR" tag="7"/>
	</control-tags>

	<!-- Generated by tools/make-assets-wetcomp.py from the panel art.
	     Do not hand-edit: re-run the script instead, so the geometry here
	     stays tied to the measured positions of the painted controls. -->
	<template background-color="~ BlackCColor"
	          bitmap="backplate"
	          class="CViewContainer"
	          name="view"
	          size="768, 512"
	          transparent="false">

		<!-- LED meters. IN and OUT read upwards in green/yellow/red;
		     GR reads DOWNWARDS from 0 in one amber, because gain
		     reduction has no danger zone. -->
		<view class="LEDMeterView"
		      control-tag="kInputMeterL"
		      origin="119, 100"
		      size="22, 179"
		      num-segments="12"
		      segment-gap="3"
		      horizontal="false"
		      inverted="false"
		      reduction-scheme="false"
		      db-min="-48"
		      db-max="18"
		      transparent="false"/>

		<view class="LEDMeterView"
		      control-tag="kInputMeterR"
		      origin="169, 100"
		      size="22, 179"
		      num-segments="12"
		      segment-gap="3"
		      horizontal="false"
		      inverted="false"
		      reduction-scheme="false"
		      db-min="-48"
		      db-max="18"
		      transparent="false"/>

		<view class="LEDMeterView"
		      control-tag="kGRMeter"
		      origin="370, 110"
		      size="28, 192"
		      num-segments="12"
		      segment-gap="3"
		      horizontal="false"
		      inverted="true"
		      reduction-scheme="true"
		      transparent="false"/>

		<view class="LEDMeterView"
		      control-tag="kOutputMeterL"
		      origin="581, 100"
		      size="22, 179"
		      num-segments="12"
		      segment-gap="3"
		      horizontal="false"
		      inverted="false"
		      reduction-scheme="false"
		      db-min="-48"
		      db-max="18"
		      transparent="false"/>

		<view class="LEDMeterView"
		      control-tag="kOutputMeterR"
		      origin="632, 100"
		      size="22, 179"
		      num-segments="12"
		      segment-gap="3"
		      horizontal="false"
		      inverted="false"
		      reduction-scheme="false"
		      db-min="-48"
		      db-max="18"
		      transparent="false"/>

		<!-- INPUT and OUTPUT. Eleven detents, one frame per printed value,
		     rendered at the measured angle of that printed value. -->
		<view class="CompKnob"
		      control-tag="kInputParam"
		      origin="79, 305"
		      size="147, 147"
		      bitmap="knob_input"
		      step-count="61"
		      coarse-step="3"
		      transparent="true"/>

		<view class="CompKnob"
		      control-tag="kOutputParam"
		      origin="541, 305"
		      size="147, 147"
		      bitmap="knob_output"
		      step-count="61"
		      coarse-step="3"
		      transparent="true"/>

		<!-- FAST / NORMAL / SLOW. One view, explicit per-button rects, so
		     the gaps between the buttons are genuinely dead - the bug
		     WetReverb shipped for two releases. -->
		<view class="ModeSwitch"
		      control-tag="kModeParam"
		      origin="302, 364"
		      size="165, 58"
		      button-rects="-0.5,25.5,46.0,57.5;58.5,25.5,106.0,57.5;118.0,25.5,164.5,57.5"
		      led-spots="22.8,7.0,5.2;82.2,7.0,5.2;141.2,7.0,5.2"
		      transparent="true"/>

	</template>

	<custom>
		<attributes name="FocusDrawing"/>
		<attributes Path="wetcompeditor.uidesc" name="VST3Editor"/>
	</custom>

	<bitmaps>
		<bitmap name="backplate" path="backplate.png"/>
		<bitmap name="knob_input" path="knob_input.png"
		        multiframe-size="147, 147"
		        multiframe-num-frames="61"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_output" path="knob_output.png"
		        multiframe-size="147, 147"
		        multiframe-num-frames="61"
		        mulitframe-frames-per-row="1"/>
	</bitmaps>
</vstgui-ui-description>
